void schedule.open_proposal_aging()
{
	// Daily schedule. Client rule: Open = 40%, Open more than 45 days = 15%, Open/HIGH = 75%
	// Days open counted from Proposal Request Date (else Created Time), same as the widget's Days Open.
	// (Deals has no Proposal Sent Date field.)
	today = zoho.currentdate;
	for each  pg in {1,2,3,4,5}
	{
		res = zoho.crm.searchRecords("Deals","(Stage:equals:Open)",pg,200);
		for each  d in res
		{
			start = ifnull(d.get("Proposal_Request_Date"),"").toString();
			if(start == "")
			{
				start = ifnull(d.get("Created_Time"),"").toString();
			}
			if(start.length() >= 10)
			{
				sd = start.subString(0,10).toDate("yyyy-MM-dd");
				if(sd.daysBetween(today) > 45 && ifnull(d.get("Probability"),0).toLong() != 15)
				{
					r = zoho.crm.updateRecord("Deals",d.get("id").toLong(),{"Probability":15});
					info r;
				}
			}
		}
		if(res.size() < 200)
		{
			break;
		}
	}
}
