void automation.proposal_automation(String dealId)
{
	// Runs on every create/edit of a Proposal (Deals).
	// 1) Proposal ID (YY + 5 digits)  2) Version IDs .1 .2 ...  3) one Scope/Version record per version row
	// 4) Current version -> Current Proposal Value  5) Awarded Contract Value = sum of DVT Won versions
	// 6) Opportunity Status + Probability   7) DVT Won version -> Project (YYMM18## + method suffix, add-ons parent-n)
	deal = zoho.crm.getRecordById("Deals",dealId.toLong());
	if(deal.get("id") == null)
	{
		return;
	}
	today = zoho.currentdate;
	upd = Map();
	// ---------- 1. Proposal ID ----------
	pid = ifnull(deal.get("Proposal_ID"),"");
	if(pid == "")
	{
		yy = today.toString("yy");
		maxn = 0;
		for each  pg in {1,2,3,4,5}
		{
			res = zoho.crm.searchRecords("Deals","(Proposal_ID:starts_with:" + yy + ")",pg,200);
			for each  d in res
			{
				s = ifnull(d.get("Proposal_ID"),"");
				if(s.length() == 7 && s.isNumber())
				{
					n = s.subString(2).toLong();
					if(n > maxn)
					{
						maxn = n;
					}
				}
			}
			if(res.size() < 200)
			{
				break;
			}
		}
		pid = yy + (maxn + 1).toString().leftPad(5).replaceAll(" ","0");
		upd.put("Proposal_ID",pid);
	}
	// ---------- 2. Version IDs ----------
	rows = ifnull(deal.get("Proposal_Services_Scope"),List());
	maxv = 0;
	for each  r in rows
	{
		v = ifnull(r.get("Version_ID"),"");
		if(v.contains("."))
		{
			sfx = v.getSuffix(".");
			if(sfx.isNumber() && sfx.toLong() > maxv)
			{
				maxv = sfx.toLong();
			}
		}
	}
	openSet = {"New Request","Qualifying","Preparing Proposal","Open","Open/HIGH"};
	newRows = List();
	rowsChanged = false;
	for each  r in rows
	{
		nr = Map();
		nr.put("id",r.get("id"));
		v = ifnull(r.get("Version_ID"),"");
		if(v == "")
		{
			maxv = maxv + 1;
			v = pid + "." + maxv;
			nr.put("Version_ID",v);
			rowsChanged = true;
		}
		if(isNull(r.get("Version_Status")))
		{
			nr.put("Version_Status","New Request");
			r.put("Version_Status","New Request");
			rowsChanged = true;
		}
		r.put("Version_ID",v);
		newRows.add(nr);
	}
	// ---------- 3. Scope/Version records ----------
	stateMap = {"Alabama":"AL","Alaska":"AK","Arizona":"AZ","Arkansas":"AR","California":"CA","Colorado":"CO","Connecticut":"CT","Delaware":"DE","Florida (United States)":"FL","Georgia":"GA","Hawaii":"HI","Idaho":"ID","Illinois":"IL","Indiana":"IN","Iowa":"IA","Kansas":"KS","Kentucky":"KY","Louisiana":"LA","Maine":"ME","Maryland":"MD","Massachusetts":"MA","Michigan":"MI","Minnesota":"MN","Mississippi":"MS","Missouri":"MO","Montana (United States)":"MT","Nebraska":"NE","Nevada":"NV","New Hampshire":"NH","New Jersey":"NJ","New Mexico":"NM","New York":"NY","North Carolina":"NC","North Dakota":"ND","Ohio":"OH","Oklahoma":"OK","Oregon":"OR","Pennsylvania":"PA","Rhode Island":"RI","South Carolina":"SC","South Dakota":"SD","Tennessee":"TN","Texas":"TX","Utah":"UT","Vermont":"VT","Virginia":"VA","Washington":"WA","West Virginia":"WV","Wisconsin":"WI","Wyoming":"WY"};
	verRecs = Map();
	existing = zoho.crm.searchRecords("Data_Aquisition","(Proposal_Name:equals:" + dealId + ")");
	for each  e in existing
	{
		if(e.get("Proposal_Version_ID") != null)
		{
			verRecs.put(e.get("Proposal_Version_ID"),e);
		}
	}
	for each  r in rows
	{
		v = r.get("Version_ID");
		title = ifnull(r.get("Proposal_Title"),ifnull(deal.get("Deal_Name"),""));
		dm = Map();
		nm = v + " - " + title;
		if(nm.length() > 120)
		{
			nm = nm.subString(0,120);
		}
		dm.put("Name",nm);
		dm.put("Proposal_Name",dealId);
		dm.put("Proposal_Version_ID",v);
		dm.put("Version_Status",r.get("Version_Status"));
		dm.put("Date_of_Proposal",r.get("Request_Date"));
		dm.put("Project_City",deal.get("Opportunity_City"));
		st = deal.get("Opportunity_State");
		if(st != null && stateMap.containsKey(st))
		{
			dm.put("Project_State",stateMap.get(st));
		}
		dm.put("Project_Type",r.get("Project_Type"));
		dm.put("Project_Deliverables",r.get("Project_Deliverables"));
		dm.put("Mapping_Acres",r.get("Mapping_Acres"));
		dm.put("Flight_Acres",r.get("Flight_Acres"));
		if(r.get("GSD") != null)
		{
			dm.put("GSD",r.get("GSD").toString());
		}
		if(r.get("LiDAR_PPSM") != null)
		{
			dm.put("LiDAR_PPSM",r.get("LiDAR_PPSM").toDecimal().round(0).toLong());
		}
		dm.put("Proposal_Cost",r.get("Proposal_Total"));
		if(verRecs.containsKey(v))
		{
			zoho.crm.updateRecord("Data_Aquisition",verRecs.get(v).get("id"),dm);
		}
		else
		{
			cr = zoho.crm.createRecord("Data_Aquisition",dm);
			if(cr.get("id") != null)
			{
				dm.put("id",cr.get("id"));
				verRecs.put(v,dm);
			}
		}
	}
	// ---------- 4. Current version / 5. Awarded value ----------
	cur = ifnull(deal.get("Current_Version"),"");
	curRow = null;
	latestOpen = null;
	latestAny = null;
	awarded = 0.0;
	anyWon = false;
	for each  r in rows
	{
		latestAny = r;
		if(openSet.contains(r.get("Version_Status")))
		{
			latestOpen = r;
		}
		if(r.get("Version_ID") == cur)
		{
			curRow = r;
		}
		if(r.get("Version_Status") == "DVT Won")
		{
			anyWon = true;
			awarded = awarded + ifnull(r.get("Proposal_Total"),0).toDecimal();
		}
	}
	// current = the version the user picked if it is still open; else latest open; else latest version
	if(curRow == null || !openSet.contains(curRow.get("Version_Status")) && !anyWon)
	{
		if(latestOpen != null)
		{
			curRow = latestOpen;
		}
		else if(curRow == null)
		{
			curRow = latestAny;
		}
	}
	if(anyWon)
	{
		for each  r in rows
		{
			if(r.get("Version_Status") == "DVT Won")
			{
				curRow = r;
				break;
			}
		}
	}
	status = deal.get("Stage");
	if(curRow != null)
	{
		if(curRow.get("Version_ID") != cur)
		{
			upd.put("Current_Version",curRow.get("Version_ID"));
		}
		if(anyWon)
		{
			upd.put("Current_Proposal_Value1",awarded);
		}
		else
		{
			upd.put("Current_Proposal_Value1",ifnull(curRow.get("Proposal_Total"),0));
		}
		// ---------- 6. single Opportunity Status ----------
		if(anyWon)
		{
			status = "DVT Won";
		}
		else
		{
			status = curRow.get("Version_Status");
		}
		upd.put("Stage",status);
	}
	if(anyWon)
	{
		upd.put("Awarded_Contract_Value1",awarded);
	}
	sent = deal.get("Proposal_Sent_Date");
	if((status == "Open" || status == "Open/HIGH") && sent == null)
	{
		sent = today;
		upd.put("Proposal_Sent_Date",today);
	}
	prob = 0;
	if(status == "New Request")
	{
		prob = 10;
	}
	else if(status == "Qualifying")
	{
		prob = 20;
	}
	else if(status == "Preparing Proposal")
	{
		prob = 40;
	}
	else if(status == "Open")
	{
		prob = 40;
		if(sent != null && sent.toDate().daysBetween(today) > 45)
		{
			prob = 15;
		}
	}
	else if(status == "Open/HIGH")
	{
		prob = 75;
	}
	else if(status == "DVT Won")
	{
		prob = 100;
	}
	upd.put("Probability",prob);
	// ---------- 7. Projects for won versions ----------
	client = deal.get("Account_Name");
	clientName = "";
	if(client != null)
	{
		clientName = client.get("name");
	}
	parent = deal.get("Parent_Project");
	prefix = today.toString("yyMM") + "18";
	maxp = -1;
	for each  r in rows
	{
		if(r.get("Version_Status") == "DVT Won" && ifnull(r.get("DVT_Project_Number"),"") == "")
		{
			sensor = ifnull(r.get("Type"),"");
			sfx = "P";
			if(sensor.startsWith("Drone"))
			{
				sfx = "D";
			}
			else if(sensor.startsWith("Mobile"))
			{
				sfx = "M";
			}
			else if(sensor.contains("Scan"))
			{
				sfx = "S";
			}
			else if(sensor == "Bathy" || sensor == "Ground Survey" || sensor == "Other")
			{
				sfx = "O";
			}
			pnum = "";
			parentNum = "";
			if(parent != null)
			{
				prec = zoho.crm.getRecordById("Project",parent.get("id").toLong());
				parentNum = ifnull(prec.get("Project_number"),"");
			}
			if(parentNum != "")
			{
				kids = zoho.crm.searchRecords("Project","(Parent_Project:equals:" + parent.get("id") + ")");
				pnum = parentNum + "-" + (kids.size() + 1);
			}
			else
			{
				if(maxp < 0)
				{
					maxp = 0;
					res = zoho.crm.searchRecords("Project","(Project_number:starts_with:" + prefix + ")");
					for each  p in res
					{
						s = ifnull(p.get("Project_number"),"");
						if(s.length() >= 8)
						{
							t = s.subString(6,8);
							if(t.isNumber() && t.toLong() > maxp)
							{
								maxp = t.toLong();
							}
						}
					}
				}
				maxp = maxp + 1;
				pnum = prefix + maxp.toString().leftPad(2).replaceAll(" ","0") + sfx;
			}
			pm = Map();
			title = ifnull(r.get("Proposal_Title"),ifnull(deal.get("Deal_Name"),""));
			pname = clientName + " - " + title;
			if(pname.length() > 120)
			{
				pname = pname.subString(0,120);
			}
			pm.put("Name",pname);
			pm.put("Project_number",pnum);
			pm.put("Proposal",dealId);
			if(client != null)
			{
				pm.put("Client",client.get("id"));
			}
			if(deal.get("Contact_Name") != null)
			{
				pm.put("Contact_Name",deal.get("Contact_Name").get("id"));
			}
			if(deal.get("Owner") != null)
			{
				pm.put("Owner",deal.get("Owner").get("id"));
			}
			if(parent != null && parentNum != "")
			{
				pm.put("Parent_Project",parent.get("id"));
			}
			pm.put("Version_ID",r.get("Version_ID"));
			pm.put("Project_Status","Awarded");
			pm.put("Award_Date",today);
			pm.put("Awarded_Contract_Value",r.get("Proposal_Total"));
			pm.put("Acquisition_Method",sfx);
			pm.put("Acres",r.get("Mapping_Acres"));
			pm.put("City",deal.get("Opportunity_City"));
			pm.put("State",deal.get("Opportunity_State"));
			vr = verRecs.get(r.get("Version_ID"));
			if(vr != null && vr.get("id") != null)
			{
				full = zoho.crm.getRecordById("Data_Aquisition",vr.get("id").toLong());
				if(full.get("Selected_Acq_Vendor") != null)
				{
					pm.put("Acquisition_Vendor",full.get("Selected_Acq_Vendor").get("id"));
				}
				pm.put("Acquisition_Cost",full.get("Total_Vendor_Costs"));
				if(full.get("Selected_Mapping_Vendor") != null)
				{
					pm.put("Processing_Vendor",full.get("Selected_Mapping_Vendor").get("id"));
				}
				pm.put("Processing_Cost",full.get("Select_Mapping_Cost"));
				pm.put("DVT_Mob_Costs",full.get("Internal_Cost"));
				if(full.get("PID_or_Targets") != null)
				{
					pm.put("PID_or_Targets",full.get("PID_or_Targets"));
				}
			}
			cp = zoho.crm.createRecord("Project",pm);
			info cp;
			if(cp.get("id") != null)
			{
				for each  nr in newRows
				{
					if(nr.get("id") == r.get("id"))
					{
						nr.put("DVT_Project_Number",pnum);
					}
				}
				rowsChanged = true;
				if(deal.get("Linked_Project") == null && upd.get("Linked_Project") == null)
				{
					upd.put("Linked_Project",cp.get("id"));
				}
			}
		}
	}
	if(rowsChanged)
	{
		upd.put("Proposal_Services_Scope",newRows);
	}
	resp = zoho.crm.updateRecord("Deals",dealId.toLong(),upd);
	info resp;
}
