void automation.proposal_automation(String dealId)
{
	// Proposals (Deals) create/edit.
	// Proposal ID, one Scope/Version record per scope row (Name = ProposalID.n, linked via the row's Version ID lookup),
	// row -> version sync, Open > 45 days probability rule,
	// and on DVT Won: Open versions -> Not Selected, Final Proposal Value + one Project per Selected version.
	deal = zoho.crm.getRecordById("Deals",dealId.toLong());
	if(deal.get("id") == null)
	{
		return;
	}
	today = zoho.currentdate;
	upd = Map();
	// ---------- Proposal ID (YY + 5 digits) ----------
	pid = ifnull(deal.get("Proposal_ID"),"");
	if(pid == "")
	{
		yy = today.toString("yy");
		maxn = 0;
		for each  pg in {1,2,3,4,5}
		{
			res = zoho.crm.searchRecords("Deals","(Proposal_ID:starts_with:" + yy + ")",pg,200);
			for each  d in res
			{
				s = ifnull(d.get("Proposal_ID"),"");
				if(s.length() == 7 && s.isNumber())
				{
					n = s.subString(2).toLong();
					if(n > maxn)
					{
						maxn = n;
					}
				}
			}
			if(res.size() < 200)
			{
				break;
			}
		}
		pid = yy + (maxn + 1).toString().leftPad(5).replaceAll(" ","0");
		upd.put("Proposal_ID",pid);
	}
	// row Version Status -> version Status
	rowToVer = {"Open":"Open","Selected":"Selected","Not Selected":"Not Selected","Cancelled":"Cancelled","Abandoned":"Abandoned","DVT Won":"Selected"};
	stage = ifnull(deal.get("Stage"),"");
	// ---------- existing versions of this proposal ----------
	verById = Map();
	maxv = 0;
	vers = zoho.crm.searchRecords("Scope_Versions","(Proposal_Name:equals:" + dealId + ")");
	for each  v in vers
	{
		verById.put(v.get("id").toString(),v);
		nm = ifnull(v.get("Name"),"");
		if(nm.startsWith(pid + "."))
		{
			sfx = nm.subString(pid.length() + 1);
			if(sfx.isNumber() && sfx.toLong() > maxv)
			{
				maxv = sfx.toLong();
			}
		}
	}
	rows = ifnull(deal.get("Proposal_Services_Scope"),List());
	newRows = List();
	rowsChanged = false;
	selTotal = 0.0;
	selRows = List();
	for each  r in rows
	{
		nr = Map();
		nr.put("id",r.get("id"));
		rs = ifnull(r.get("Version_Status"),"");
		vs = "Open";
		if(rowToVer.containsKey(rs))
		{
			vs = rowToVer.get(rs);
		}
		// proposal closed as DVT Won: versions still Open become Not Selected
		if(stage == "DVT Won" && vs == "Open")
		{
			vs = "Not Selected";
			nr.put("Version_Status","Not Selected");
			rowsChanged = true;
		}
		title = ifnull(r.get("Proposal_Title"),"");
		if(title == "")
		{
			title = ifnull(deal.get("Deal_Name"),"Version");
		}
		dm = Map();
		dm.put("Title",title);
		dm.put("Status",vs);
		dm.put("Value",r.get("Proposal_Total"));
		dm.put("Project_Type",r.get("Project_Type"));
		dm.put("Project_Deliverables",r.get("Project_Deliverables"));
		dm.put("Sensor_Type",r.get("Type"));
		dm.put("Mapping_Acres",r.get("Mapping_Acres"));
		dm.put("Flight_Acres",r.get("Flight_Acres"));
		if(r.get("GSD") != null)
		{
			dm.put("GSD",r.get("GSD").toString());
		}
		if(r.get("LiDAR_PPSM") != null)
		{
			dm.put("LiDAR_PPSM",r.get("LiDAR_PPSM").toDecimal().round(0).toLong());
		}
		vref = r.get("P_Version");
		vid = "";
		if(vref != null)
		{
			vid = vref.get("id").toString();
		}
		if(vid == "" || !verById.containsKey(vid))
		{
			// new scope row -> create its Scope/Version record (no workflow trigger, so no duplicate row is added back)
			maxv = maxv + 1;
			dm.put("Name",pid + "." + maxv);
			dm.put("Proposal_Name",dealId);
			dm.put("Date_of_Proposal",ifnull(deal.get("Proposal_Request_Date"),today));
			dm.put("Project_City",deal.get("Opportunity_City"));
			cr = zoho.crm.createRecord("Scope_Versions",dm);
			info cr;
			if(cr.get("id") != null)
			{
				vid = cr.get("id").toString();
				nr.put("P_Version",vid);
				rowsChanged = true;
				dm.put("id",vid);
				verById.put(vid,dm);
			}
		}
		else
		{
			ex = verById.get(vid);
			if(!ifnull(ex.get("Name"),"").startsWith(pid + "."))
			{
				maxv = maxv + 1;
				dm.put("Name",pid + "." + maxv);
			}
			// update only what differs
			ch = Map();
			for each  k in dm.keys()
			{
				a = ifnull(dm.get(k),"").toString();
				b = ifnull(ex.get(k),"").toString();
				if(a.isNumber() && b.isNumber())
				{
					if(a.toDecimal() != b.toDecimal())
					{
						ch.put(k,dm.get(k));
					}
				}
				else if(a != b)
				{
					ch.put(k,dm.get(k));
				}
			}
			if(ch.size() > 0)
			{
				zoho.crm.updateRecord("Scope_Versions",vid.toLong(),ch,{"trigger":{"workflow"}});
			}
		}
		if(vs == "Selected")
		{
			selTotal = selTotal + ifnull(r.get("Proposal_Total"),0).toDecimal();
			selRows.add({"row":r,"vid":vid});
		}
		newRows.add(nr);
	}
	// ---------- probability: stage settings give the %; Open for more than 45 days drops to 15% ----------
	sent = deal.get("Proposal_Sent_Date");
	if((stage == "Open" || stage == "Open/HIGH") && sent == null)
	{
		sent = today;
		upd.put("Proposal_Sent_Date",today);
	}
	if(stage == "Open" && sent != null && sent.toDate().daysBetween(today) > 45)
	{
		if(ifnull(deal.get("Probability"),-1).toLong() != 15)
		{
			upd.put("Probability",15);
		}
	}
	// ---------- closure: DVT Won ----------
	if(stage == "DVT Won")
	{
		if(ifnull(deal.get("Final_Proposal_Value"),0).toDecimal() != selTotal)
		{
			upd.put("Final_Proposal_Value",selTotal);
		}
		client = deal.get("Account_Name");
		clientName = "";
		if(client != null)
		{
			clientName = client.get("name");
		}
		parent = deal.get("Parent_Project");
		parentNum = "";
		if(parent != null)
		{
			prec = zoho.crm.getRecordById("Project",parent.get("id").toLong());
			parentNum = ifnull(prec.get("Project_number"),"");
		}
		prefix = today.toString("yyMM") + "18";
		maxp = -1;
		kidCount = -1;
		for each  item in selRows
		{
			r = item.get("row");
			vid = item.get("vid");
			if(vid == "")
			{
				continue;
			}
			ver = zoho.crm.getRecordById("Scope_Versions",vid.toLong());
			if(ver.get("Project") != null)
			{
				continue;
			}
			sensor = ifnull(r.get("Type"),"");
			sfx = "P";
			if(sensor.startsWith("Drone"))
			{
				sfx = "D";
			}
			else if(sensor.startsWith("Mobile"))
			{
				sfx = "M";
			}
			else if(sensor.contains("Scan"))
			{
				sfx = "S";
			}
			else if(sensor == "Bathy" || sensor == "Ground Survey" || sensor == "Other")
			{
				sfx = "O";
			}
			if(parentNum != "")
			{
				if(kidCount < 0)
				{
					kids = zoho.crm.searchRecords("Project","(Parent_Project:equals:" + parent.get("id") + ")");
					kidCount = kids.size();
				}
				kidCount = kidCount + 1;
				pnum = parentNum + "-" + kidCount;
			}
			else
			{
				if(maxp < 0)
				{
					maxp = 0;
					res = zoho.crm.searchRecords("Project","(Project_number:starts_with:" + prefix + ")");
					for each  p in res
					{
						s = ifnull(p.get("Project_number"),"");
						if(s.length() >= 8)
						{
							t = s.subString(6,8);
							if(t.isNumber() && t.toLong() > maxp)
							{
								maxp = t.toLong();
							}
						}
					}
				}
				maxp = maxp + 1;
				pnum = prefix + maxp.toString().leftPad(2).replaceAll(" ","0") + sfx;
			}
			pm = Map();
			pname = clientName + " - " + ifnull(ver.get("Title"),ifnull(r.get("Proposal_Title"),""));
			if(pname.length() > 120)
			{
				pname = pname.subString(0,120);
			}
			pm.put("Name",pname);
			pm.put("Project_number",pnum);
			pm.put("Proposal",dealId);
			pm.put("Version_ID",ver.get("Name"));
			pm.put("Proposal_Version",vid);
			if(client != null)
			{
				pm.put("Client",client.get("id"));
			}
			if(deal.get("Contact_Name") != null)
			{
				pm.put("Contact_Name",deal.get("Contact_Name").get("id"));
			}
			if(deal.get("Owner") != null)
			{
				pm.put("Owner",deal.get("Owner").get("id"));
			}
			if(parentNum != "")
			{
				pm.put("Parent_Project",parent.get("id"));
			}
			pm.put("Project_Status","Awarded");
			pm.put("Award_Date",today);
			pm.put("Awarded_Contract_Value",ifnull(ver.get("Value"),r.get("Proposal_Total")));
			pm.put("Acquisition_Method",sfx);
			pm.put("Acres",ver.get("Mapping_Acres"));
			pm.put("City",deal.get("Opportunity_City"));
			pm.put("State",deal.get("Opportunity_State"));
			pm.put("Acquisition_Cost",ver.get("Total_Vendor_Costs"));
			pm.put("Processing_Cost",ver.get("Select_Mapping_Cost"));
			if(ver.get("PID_or_Targets") != null)
			{
				pm.put("PID_or_Targets",ver.get("PID_or_Targets"));
			}
			for each  q in ifnull(ver.get("Acquisition_Vendor_Quotes"),List())
			{
				if(ifnull(q.get("Is_Selected_Vendor"),false) == true && q.get("Acquisition_Vendor") != null)
				{
					pm.put("Acquisition_Vendor",q.get("Acquisition_Vendor").get("id"));
				}
			}
			for each  q in ifnull(ver.get("Mapping_Quotes"),List())
			{
				if(ifnull(q.get("Is_Selected_Mapping_Vendor"),false) == true && q.get("Mapping_Vendor_Name") != null)
				{
					pm.put("Processing_Vendor",q.get("Mapping_Vendor_Name").get("id"));
				}
			}
			cp = zoho.crm.createRecord("Project",pm);
			info cp;
			if(cp.get("id") != null)
			{
				zoho.crm.updateRecord("Scope_Versions",vid.toLong(),{"Project":cp.get("id")});
				if(deal.get("Linked_Project") == null && upd.get("Linked_Project") == null)
				{
					upd.put("Linked_Project",cp.get("id"));
				}
			}
		}
	}
	if(rowsChanged)
	{
		upd.put("Proposal_Services_Scope",newRows);
	}
	if(upd.size() > 0)
	{
		resp = zoho.crm.updateRecord("Deals",dealId.toLong(),upd);
		info resp;
	}
}
