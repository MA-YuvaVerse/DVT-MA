# Postgres connection
DATABASE_URL="postgresql://dvt:dvt_dev@localhost:5432/dvt_app?schema=public"

# Long random string used to sign login sessions (openssl rand -base64 48)
AUTH_SECRET="change-me-to-a-long-random-string"

# First admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Administrator"

# Where uploaded documents are stored (local provider)
UPLOAD_DIR="./storage/uploads"

# Set to "true" to load demo companies/proposals when seeding
SEED_DEMO_DATA="true"
